+// printGasEstimate writes the simulation result. For --dry-run --output json
+// it prints {"gas_estimate":N} on stdout. Other --gas auto paths keep the
+// human line on stderr so they do not corrupt a broadcast or generate-only
+// payload on stdout.
+func printGasEstimate(clientCtx client.Context, gas uint64) {
+	resp := GasEstimateResponse{GasEstimate: gas}
+	if clientCtx.OutputFormat == "json" {
+		bz, err := json.Marshal(resp)
+		if err == nil {
+			if clientCtx.Simulate {
+				_ = clientCtx.PrintBytes(append(bz, '\n'))
+				return
+			}
+			_, _ = fmt.Fprintf(os.Stderr, "%s\n", bz)
+			return
+		}
+	}
+	_, _ = fmt.Fprintf(os.Stderr, "%s\n", resp)
+}
